# Gemini API key from https://aistudio.google.com/app/apikey
# Read only by the server — it is never sent to the browser.
GEMINI_API_KEY=your_api_key_here

# Optional overrides (defaults shown)
# PORT=3000
# SIMULATIONS_PER_HOUR=10       # per IP
# CHAT_MESSAGES_PER_HOUR=100    # per IP
# DAILY_SIMULATION_CAP=200      # whole server, resets at UTC midnight
# DAILY_CHAT_CAP=2000           # whole server, resets at UTC midnight
# TRUST_PROXY=1                 # set when deployed behind a reverse proxy

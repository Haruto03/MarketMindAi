# ── Gemini ───────────────────────────────────────────────────────────────────
# API key from https://aistudio.google.com/app/apikey
# Read only by the server — it is never sent to the browser.
GEMINI_API_KEY=your_api_key_here

# ── Supabase (login + database) ──────────────────────────────────────────────
# Local: run `npx supabase start`, then copy the values from `npx supabase status`.
# Cloud: Project Settings → API in the Supabase dashboard.

# Public values, bundled into the browser app (safe to expose: the database
# tables deny all direct access; data only flows through the server).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# SECRET — server only. Never prefix with VITE_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# Optional; defaults to VITE_SUPABASE_URL
# SUPABASE_URL=

# ── Optional overrides (defaults shown) ──────────────────────────────────────
# PORT=3000
# SIMULATIONS_PER_HOUR=10       # per signed-in user
# CHAT_MESSAGES_PER_HOUR=100    # per user
# GUEST_SIMULATIONS_PER_HOUR=2  # per guest (anonymous sign-in)
# GUEST_CHAT_MESSAGES_PER_HOUR=20
# DAILY_SIMULATION_CAP=200      # whole service, resets at UTC midnight
# DAILY_CHAT_CAP=2000           # whole service, resets at UTC midnight
# API_REQUESTS_PER_15_MIN=300   # per IP, all API endpoints
# TRUST_PROXY=1                 # set when deployed behind a reverse proxy
